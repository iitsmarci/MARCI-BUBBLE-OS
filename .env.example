# ===========================================
# MARCI BUBBLE - Environment Configuration
# ===========================================
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control!

# ===========================================
# SERVER-SIDE ONLY (not exposed to client)
# ===========================================

# iCloud Calendar credentials (server-side only)
# Used for calendar sync via CalDAV
ICLOUD_USERNAME=your_email@example.com
ICLOUD_APP_PASSWORD=your-app-specific-password

# Timezone for calendar events
CALENDAR_TIMEZONE=Europe/Rome

# ===========================================
# CLIENT-SIDE PUBLIC (safe to expose)
# ===========================================
# Vite exposes VITE_ prefixed variables to the browser.
# These are considered PUBLIC API keys with rate limits.

# Last.fm API credentials for Now Playing bubble
# WARNING: These are rate-limited API keys. Do NOT expose sensitive data.
VITE_LASTFM_USERNAME=your_lastfm_username
VITE_LASTFM_API_KEY=your_public_api_key_here

# Calendar feed URLs (public read-only URLs)
# Either iCloud CalDAV (server handles auth) or public iCal URL
VITE_APPLE_USER=                    # Deprecated - use ICLOUD_USERNAME
VITE_APPLE_APP_PASSWORD=            # Deprecated - use ICLOUD_APP_PASSWORD
VITE_APPLE_CALENDAR_URL=
VITE_CALENDAR_ICAL_URL=https://example.com/calendar.ics

# ===========================================
# OPTIONAL
# ===========================================
ANTIGRAVITY_AUTO_APPROVE=true