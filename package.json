{
  "name": "marci-bubble",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k \"npm:dev:client\" \"npm:dev:calendar\"",
    "dev:client": "vite",
    "dev:calendar": "tsx watch server/index.ts",
    "build": "node ./node_modules/typescript/bin/tsc -p tsconfig.json && vite build",
    "check": "node ./node_modules/typescript/bin/tsc -p tsconfig.json && node ./node_modules/typescript/bin/tsc -p tsconfig.server.json",
    "test:e2e": "playwright test",
    "preview": "vite preview"
  },
  "dependencies": {
    "@vitejs/plugin-react": "latest",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.0",
    "helmet": "^8.3.0",
    "ical.js": "^2.2.1",
    "lucide-react": "latest",
    "react": "latest",
    "react-dom": "latest",
    "tsdav": "^2.3.1",
    "typescript": "latest",
    "vite": "latest"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@types/express": "^5.0.6",
    "@types/node": "^26.3.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "concurrently": "^10.0.5",
    "playwright": "^1.62.1",
    "tsx": "^4.23.12"
  }
}
